{
  "manifest_version": 3,
  "name": "Sophia Assistant",
  "version": "2.10.0",
  "description": "Sophia answers questions from the BetterCare SharePoint site, with a citation for every answer.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://uthealthsa.sharepoint.com/sites/BetterCare/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.run.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Sophia",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://uthealthsa.sharepoint.com/sites/BetterCare/*"
      ],
      "js": [
        "launcher.js"
      ],
      "css": [
        "launcher.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
