# Sophia server settings. Copy to .env for local runs (npm start reads it);
# on GCP set them as environment variables / secrets instead. Every line is
# optional: a value shown is the default, and an empty value means the
# default. Lines left empty here have a default that depends on where the
# server runs ("deployed" is Google Cloud or the Docker image, which sets
# NODE_ENV=production; "laptop" is anywhere else); the comment above each
# gives both. Lines marked SECRET hold keys or passwords: leave them empty
# here and never commit real ones.
#
# A deployment needs only: ANTHROPIC_API_KEY, ADMIN_PASSWORD (both secrets),
# and, if the export is mounted somewhere else, SITE_DIR.

# ------------------------------------------------------------ server
# Deployed: 0.0.0.0 (every interface). Laptop: 127.0.0.1 (this machine only).
HOST=
PORT=8787

# ------------------------------------------------------------ AI providers
# Without a key Sophia still runs: answers show the best-matching site content.
# SECRET: Claude (Anthropic) API key, e.g. sk-ant-api03-…
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# The search-rewrite step; defaults to ANTHROPIC_MODEL.
REWRITE_MODEL=
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=low
MAX_TOKENS=8192
# Server-side fallback when the model declines (Claude API only; set 0 on Bedrock/Vertex/Foundry).
REFUSAL_FALLBACK=1
# SECRET: OpenAI key for the backup provider, used when Claude can't be reached, e.g. sk-proj-…
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_QUICK_MODEL=gpt-5.4-mini
# claude | openai: which provider answers first.
LLM_PRIMARY=claude
# 1 turns the backup off; LLM_DISABLED=1 turns the AI off entirely.
BACKUP_DISABLED=
LLM_DISABLED=

# ------------------------------------------------------------ database
# firestore or sqlite (one file). Deployed: firestore. Laptop: sqlite.
DATABASE=
# The SQLite file. Deployed: /tmp/sophia/sophia.db (lost on restart). Laptop: data/sophia.db.
SOPHIA_DB=
# Firestore: credentials come from the service account on GCP, or locally
# from `gcloud auth application-default login`. Empty project:
# GOOGLE_CLOUD_PROJECT, else the credentials' project. The service account
# needs roles/datastore.user.
# e.g. FIRESTORE_PROJECT_ID=my-gcp-project
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
# Put in front of every collection name, so two deployments can share one database.
FIRESTORE_COLLECTION_PREFIX=

# ------------------------------------------------------------ sign-in
# password: username/password accounts in the database; everything needs a
#           signed-in person (the deployed setting).
# header:   no sign-in, trusts the X-Sophia-User header. Local development only.
AUTH_MODE=password
SESSION_DAYS=7
# Created at startup as an admin (or its password reset to this one).
ADMIN_USERNAME=admin
# SECRET: the admin account's password (8+ characters). Empty: no account is created.
ADMIN_PASSWORD=
# Usernames or emails that are admins whenever they sign in, comma-separated.
ADMIN_USERS=
# 1 lets people create their own account on the sign-in page.
ALLOW_SIGNUP=
# 1 lets the extension sign people in as whoever is signed in to SharePoint.
# The server can't verify that: demos only, until Microsoft sign-in.
SHAREPOINT_SIGNIN=
SHAREPOINT_EMAIL_DOMAINS=uthscsa.edu,uthealthsa.org
# 1 always marks the cookie Secure (it already is on HTTPS requests).
COOKIE_SECURE=
# SECRET (tools only): `npm run seed:demo` gives the demo people this password.
DEMO_PASSWORD=

# ------------------------------------------------------------ data files
# Paths are relative to the working directory; empty ones default to these
# places in the app folder.
# The search index (committed): data/index/chunks.json and data/embeddings.json.
CHUNKS_FILE=
EMBEDDINGS_FILE=
# Where the embedding model is cached (the Docker build downloads it there): .models/.
MODEL_CACHE_DIR=
# The BetterCare site export served as the website; optional (see README, "Data").
# Deployed: /data/site (mount it there). Laptop: data/site.
SITE_DIR=
# Saved results of the admin panel's Tests tab. Deployed: /tmp/sophia/test-results. Laptop: data/eval.
TEST_RESULTS_DIR=
# Per-question diagnostics: a file path, "-" for standard output, or "off".
# Deployed: - (Cloud Logging). Laptop: data/logs/chat.jsonl.
CHAT_LOG=

# ------------------------------------------------------------ search and limits
SITE_NAME=BetterCare
SITE_URL=https://uthealthsa.sharepoint.com/sites/BetterCare
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
RETRIEVAL_CANDIDATES=40
RETRIEVAL_TOP_K=8
MAX_PER_SOURCE=3
BROAD_TOP_K=16
BROAD_MAX_PER_SOURCE=8
LOW_CONFIDENCE_THRESHOLD=0.69
RECENT_WINDOW_DAYS=365
MAX_HISTORY_TURNS=10
MAX_QUESTION_CHARS=2000
RATE_LIMIT_MESSAGES=30
RATE_LIMIT_WINDOW_MIN=10
